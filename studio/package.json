{
  "name": "studio",
  "private": true,
  "version": "0.1.0",
  "description": "Sanity Studio for JS One",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "typegen": "sanity schema extract --enforce-required-fields --path=./schema.json && sanity typegen generate",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/document-internationalization": "^6.2.46",
    "@sanity/icons": "^5.3.0",
    "@sanity/vision": "^6.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sanity": "^6.22.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}

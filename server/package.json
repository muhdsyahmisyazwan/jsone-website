{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Node server - static site + API (Ubuntu / any VPS)",
  "scripts": {
    "dev": "node --env-file=.env.development ../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@sanity/client": "^7.28.0",
    "@sanity/preview-url-secret": "^3.0.0",
    "hono": "^4.10.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}

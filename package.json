{
  "name": "jsone-website",
  "private": true,
  "version": "0.1.0",
  "description": "JSOne corporate website - Astro + Sanity + Node API monorepo",
  "workspaces": [
    "web",
    "studio",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:web": "npm run dev -w web",
    "dev:studio": "npm run dev -w studio",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w web && npm run build -w server",
    "build:web": "npm run build -w web",
    "build:server": "npm run build -w server",
    "build:studio": "npm run build -w studio",
    "start": "npm run start -w server",
    "preview": "npm run preview -w web",
    "serve": "npm run build && npm run start"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}

---
import type {Locale} from '../../i18n/locales'
import {t} from '../../i18n/utils'
import SapOpenTextMap from '../illustrations/SapOpenTextMap.astro'
import SanityImage from '../sanity/SanityImage.astro'
import {resolveLocaleLink, resolveLink} from '../../lib/sanity/links'
import {resolveMaybeLocaleString} from '../../lib/sanity/locale'
import type {Link, LocaleLink, LocaleString, LocaleText, SanityImage as Img} from '../../lib/sanity/types'

interface Props {
  locale: Locale
  localized?: boolean
  section: {
    eyebrow?: string | LocaleString
    heading?: string | LocaleString
    body?: string | LocaleText
    primaryCta?: Link | LocaleLink
    secondaryCta?: Link | LocaleLink
    image?: Img
    /** Ignored in hero: metrics belong in Proof / Clients only. */
    stats?: Array<{label?: string | LocaleString; value?: string | LocaleString}>
  }
}

const {locale, localized = false, section} = Astro.props

const heading = resolveMaybeLocaleString(section.heading, locale)
const eyebrow = resolveMaybeLocaleString(section.eyebrow, locale)
const body = resolveMaybeLocaleString(section.body, locale)
const primary = localized
  ? resolveLocaleLink(section.primaryCta as LocaleLink, locale)
  : resolveLink(section.primaryCta as Link, locale)
const secondary = localized
  ? resolveLocaleLink(section.secondaryCta as LocaleLink, locale)
  : resolveLink(section.secondaryCta as Link, locale)

const hasImage = Boolean(section.image)
---

{
  heading && (
    <section class="hero-stage relative overflow-hidden border-b border-border">
      <div class="hero-bleed pointer-events-none absolute inset-0 -z-10 surface-grid" aria-hidden="true"></div>

      {hasImage ? (
        <div class="pointer-events-none absolute inset-0 -z-10 opacity-25">
          <SanityImage
            image={section.image}
            locale={locale}
            class="size-full object-cover"
            maxWidth={2000}
            priority
            lazy={false}
          />
        </div>
      ) : (
        <div
          class="pointer-events-none absolute inset-y-0 right-0 hidden w-[min(58%,40rem)] items-center lg:flex"
          aria-hidden="true"
        >
          <SapOpenTextMap locale={locale} class="w-full pr-4 xl:pr-10" />
        </div>
      )}

      <div class="container-site relative grid items-center gap-8 py-12 sm:gap-10 sm:py-16 lg:min-h-[min(78dvh,40rem)] lg:py-20">
        <div class="flex max-w-xl flex-col justify-center gap-6 bg-bg py-2 lg:max-w-[42%] lg:py-4">
          {eyebrow && <p class="eyebrow" data-preview-field="hero-eyebrow">{eyebrow}</p>}
          <h1 class="display-xl text-fg" data-preview-field="hero-heading">{heading}</h1>
          {body && (
            <p
              class="prose-measure text-base leading-relaxed text-fg-muted sm:text-lg"
              data-preview-field="hero-body"
            >
              {body}
            </p>
          )}
          {(primary || secondary) && (
            <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
              {primary && (
                <a
                  href={primary.href}
                  class="btn btn-cta w-full sm:w-auto"
                  target={primary.openInNewTab ? '_blank' : undefined}
                  rel={primary.openInNewTab ? 'noopener noreferrer' : undefined}
                >
                  {primary.label}
                  {primary.openInNewTab && (
                    <span class="sr-only"> ({t(locale, 'common.opensNewTab')})</span>
                  )}
                </a>
              )}
              {secondary && (
                <a
                  href={secondary.href}
                  class="btn btn-ghost w-full sm:w-auto"
                  target={secondary.openInNewTab ? '_blank' : undefined}
                  rel={secondary.openInNewTab ? 'noopener noreferrer' : undefined}
                >
                  {secondary.label}
                  {secondary.openInNewTab && (
                    <span class="sr-only"> ({t(locale, 'common.opensNewTab')})</span>
                  )}
                </a>
              )}
            </div>
          )}
        </div>

        {!hasImage && (
          <div class="min-w-0 lg:hidden">
            <SapOpenTextMap locale={locale} class="w-full" />
          </div>
        )}
      </div>
    </section>
  )
}

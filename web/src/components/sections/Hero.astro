---
import type {Locale} from '../../i18n/locales'
import {t} from '../../i18n/utils'
import NetworkGraph from '../illustrations/NetworkGraph.astro'
import SanityImage from '../sanity/SanityImage.astro'
import {resolveLocaleLink, resolveLink} from '../../lib/sanity/links'
import {resolveMaybeLocaleString} from '../../lib/sanity/locale'
import type {Link, LocaleLink, LocaleString, LocaleText, SanityImage as Img} from '../../lib/sanity/types'

interface Props {
  locale: Locale
  localized?: boolean
  section: {
    eyebrow?: string | LocaleString
    heading?: string | LocaleString
    body?: string | LocaleText
    primaryCta?: Link | LocaleLink
    secondaryCta?: Link | LocaleLink
    image?: Img
    stats?: Array<{label?: string | LocaleString; value?: string | LocaleString}>
  }
}

const {locale, localized = false, section} = Astro.props

const heading = resolveMaybeLocaleString(section.heading, locale)
const eyebrow = resolveMaybeLocaleString(section.eyebrow, locale)
const body = resolveMaybeLocaleString(section.body, locale)
const primary = localized
  ? resolveLocaleLink(section.primaryCta as LocaleLink, locale)
  : resolveLink(section.primaryCta as Link, locale)
const secondary = localized
  ? resolveLocaleLink(section.secondaryCta as LocaleLink, locale)
  : resolveLink(section.secondaryCta as Link, locale)

const stats = (section.stats || [])
  .map((s) => ({label: resolveMaybeLocaleString(s.label, locale), value: resolveMaybeLocaleString(s.value, locale)}))
  .filter((s) => s.label)
---

{
  heading && (
    <section class="hero-stage relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0 surface-grid opacity-60" aria-hidden="true" />
      <div
        class="pointer-events-none absolute -right-16 top-16 hidden w-[min(48vw,32rem)] opacity-70 lg:block"
        aria-hidden="true"
      >
        <NetworkGraph class="w-full text-fg-subtle" />
      </div>
      {section.image && (
        <div class="pointer-events-none absolute inset-0 -z-10 opacity-20">
          <SanityImage
            image={section.image}
            locale={locale}
            class="size-full object-cover"
            maxWidth={2000}
            priority
            lazy={false}
          />
        </div>
      )}
      <div class="container-site flex min-h-[min(78svh,40rem)] flex-col justify-center gap-6 py-12 sm:py-16 lg:min-h-[min(78dvh,40rem)] lg:py-20">
        {eyebrow && <p class="eyebrow" data-preview-field="hero-eyebrow">{eyebrow}</p>}
        <h1 class="display-xl max-w-3xl text-fg" data-preview-field="hero-heading">{heading}</h1>
        {body && (
          <p
            class="prose-measure text-base leading-relaxed text-fg-muted sm:text-lg"
            data-preview-field="hero-body"
          >
            {body}
          </p>
        )}
        {(primary || secondary) && (
          <div class="flex flex-wrap items-center gap-3 pt-1">
            {primary && (
              <a
                href={primary.href}
                class="btn btn-primary"
                target={primary.openInNewTab ? '_blank' : undefined}
                rel={primary.openInNewTab ? 'noopener noreferrer' : undefined}
              >
                {primary.label}
                {primary.openInNewTab && (
                  <span class="sr-only"> ({t(locale, 'common.opensNewTab')})</span>
                )}
              </a>
            )}
            {secondary && (
              <a
                href={secondary.href}
                class="btn btn-ghost"
                target={secondary.openInNewTab ? '_blank' : undefined}
                rel={secondary.openInNewTab ? 'noopener noreferrer' : undefined}
              >
                {secondary.label}
                {secondary.openInNewTab && (
                  <span class="sr-only"> ({t(locale, 'common.opensNewTab')})</span>
                )}
              </a>
            )}
          </div>
        )}
      </div>
      {stats.length > 0 && (
        <div class="border-t border-border bg-bg-elevated/80">
          <div class="container-site grid gap-6 py-8 sm:grid-cols-3">
            {stats.map((stat) => (
              <p class="text-center">
                {stat.value && (
                  <span class="metric block text-3xl font-semibold text-fg" data-count={stat.value}>
                    {stat.value}
                  </span>
                )}
                <span class="mt-1 block text-sm text-fg-muted">{stat.label}</span>
              </p>
            ))}
          </div>
        </div>
      )}
    </section>
  )
}

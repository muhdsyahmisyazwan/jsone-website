---
import type {Locale} from '../i18n/locales'
import {t} from '../i18n/utils'
import {fallbackTeamGroups} from '../data/fallbackTeam'

interface Props {
  locale: Locale
}

const {locale} = Astro.props

const groups = fallbackTeamGroups.map((group) => ({
  title: t(locale, group.titleKey),
  members: group.members.map((member) => ({
    name: member.name,
    role: t(locale, member.roleKey),
  })),
}))
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 surface-grid opacity-50" aria-hidden="true"></div>
  <div class="container-site space-y-4 py-20 text-center sm:py-24">
    <p class="eyebrow">{t(locale, 'nav.aboutTeam')}</p>
    <h1 class="display-xl text-fg">{t(locale, 'aboutTeam.heroTitle')}</h1>
    <p class="prose-measure mx-auto text-fg-muted sm:text-lg">
      {t(locale, 'aboutTeam.heroSubtitle')}
    </p>
  </div>
</section>

<section class="section-pad section-defer bg-bg-muted/40" data-reveal>
  <div class="container-site max-w-3xl space-y-5">
    <p class="eyebrow">{t(locale, 'aboutTeam.founderTag')}</p>
    <h2 class="display-md text-fg">{t(locale, 'aboutTeam.founderHeading')}</h2>
    <p class="prose-measure text-fg-muted">{t(locale, 'aboutTeam.founderBody1')}</p>
    <p class="prose-measure text-fg-muted">{t(locale, 'aboutTeam.founderBody2')}</p>
    <p class="pt-2 text-fg-muted">
      {t(locale, 'aboutTeam.founderSignOff')}<br />
      <strong class="text-lg font-semibold text-fg">{t(locale, 'aboutTeam.founderName')}</strong><br />
      <span class="text-sm text-fg-subtle">{t(locale, 'aboutTeam.founderRole')}</span>
    </p>
  </div>
</section>

<section class="section-pad section-defer" data-reveal>
  <div class="container-site space-y-12">
    <h2 class="display-md text-center text-fg">{t(locale, 'aboutTeam.orgHeading')}</h2>
    {
      groups.map((group) => (
        <div class="space-y-5">
          <p class="eyebrow">{group.title}</p>
          <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {group.members.map((member) => (
              <li class="card card-spotlight p-5" data-reveal-child>
                <p class="font-semibold text-fg">{member.name}</p>
                <p class="mt-1 text-sm text-fg-muted">{member.role}</p>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

---
import type {Locale} from '../i18n/locales'
import {t} from '../i18n/utils'
import ContactForm from './sections/ContactForm.astro'

interface Props {
  locale: Locale
}

const {locale} = Astro.props

const email = t(locale, 'site.email')
const phone = t(locale, 'site.phone')
const address = t(locale, 'site.address')
const hours = t(locale, 'site.hours')
const hoursNote = t(locale, 'site.hoursNote')
const registration = t(locale, 'site.registration')
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`

const topics = [
  'contact.topicAssessment',
  'contact.topicImplementation',
  'contact.topicAms',
  'contact.topicPartnership',
  'contact.topicOther',
] as const
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 surface-grid opacity-50" aria-hidden="true"></div>
  <div class="container-site grid gap-10 py-20 lg:grid-cols-2 lg:items-end lg:py-24">
    <div class="space-y-4">
      <p class="eyebrow">{t(locale, 'nav.contact')}</p>
      <h1 class="display-xl text-fg">{t(locale, 'contact.heroTitle')}</h1>
      <p class="prose-measure text-base text-fg-muted sm:text-lg">
        {t(locale, 'contact.heroSubtitle')}
      </p>
      <div class="space-y-3 pt-2">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-fg-subtle">
          {t(locale, 'contact.topicsHeading')}
        </h2>
        <ul class="flex flex-wrap gap-2">
          {
            topics.map((key) => (
              <li class="inline-flex min-h-10 items-center rounded-full border border-border bg-bg-elevated px-4 text-sm text-fg-muted">
                {t(locale, key)}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="space-y-4 rounded-[var(--radius-xl)] border border-border bg-bg-elevated p-6 shadow-[var(--shadow-sm)]">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-fg-subtle">
        {t(locale, 'contact.detailsHeading')}
      </h2>
      <p class="text-sm leading-relaxed text-fg-muted">{address}</p>
      <p>
        <a
          class="text-sm font-semibold text-primary hover:opacity-80"
          href={mapsHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t(locale, 'contact.mapLink')}
          <span class="sr-only"> ({t(locale, 'common.opensNewTab')})</span>
        </a>
      </p>
      <p>
        <a class="text-sm font-semibold text-primary hover:opacity-80" href={`tel:${phone.replace(/[^\d+]/g, '')}`}>
          {phone}
        </a>
      </p>
      <p>
        <a class="text-sm font-semibold text-primary hover:opacity-80" href={`mailto:${email}`}>
          {email}
        </a>
      </p>
      <div class="border-t border-border pt-4 text-sm text-fg-muted">
        <p class="font-semibold text-fg">{t(locale, 'contact.hoursLabel')}</p>
        <p class="mt-1">{hours}</p>
        <p class="mt-1">{hoursNote}</p>
      </div>
      <div class="border-t border-border pt-4 text-sm text-fg-muted">
        <p class="font-semibold text-fg">{t(locale, 'contact.registrationLabel')}</p>
        <p class="mt-1 font-mono text-xs">{registration}</p>
      </div>
      <div class="border-t border-border pt-4 text-sm text-fg-muted">
        <p class="font-semibold text-fg">{t(locale, 'contact.responseHeading')}</p>
        <p class="mt-1">{t(locale, 'contact.responseBody')}</p>
      </div>
    </div>
  </div>
</section>

<ContactForm
  locale={locale}
  section={{
    heading: t(locale, 'nav.getInTouch'),
    intro: t(locale, 'contact.formIntro'),
    showPhone: true,
    showCompany: true,
  }}
/>

---
import type {Locale} from '../i18n/locales'
import {t} from '../i18n/utils'

interface Props {
  locale: Locale
  class?: string
}

const {locale, class: className = ''} = Astro.props
const label = t(locale, 'theme.label')
const toLight = t(locale, 'theme.toLight')
const toDark = t(locale, 'theme.toDark')
const toSystem = t(locale, 'theme.toSystem')
---

<button
  type="button"
  class:list={[
    'inline-flex size-11 items-center justify-center rounded-full border border-border bg-bg-elevated text-fg transition-[border-color,background-color,transform] duration-150 [@media(hover:hover)_and_(pointer:fine)]:hover:border-primary active:bg-bg-muted',
    className,
  ]}
  data-theme-toggle
  aria-label={label}
  title={label}
>
  <span class="relative size-5" aria-hidden="true">
    <svg data-icon-sun class="absolute inset-0 size-5 opacity-0 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
    <svg data-icon-moon class="absolute inset-0 size-5 opacity-0 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
      <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path>
    </svg>
    <svg data-icon-system class="absolute inset-0 size-5 opacity-0 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
      <rect x="3" y="4" width="18" height="12" rx="2"></rect>
      <path d="M8 20h8M12 16v4"></path>
    </svg>
  </span>
</button>

<script define:vars={{toLight, toDark, toSystem, label}}>
  function resolveTheme(preference) {
    if (preference === 'light' || preference === 'dark') return preference
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
  }

  function syncThemeColorMeta() {
    const meta = document.querySelector('meta[name="theme-color"]')
    if (!meta) return
    const themeColor = getComputedStyle(document.documentElement)
      .getPropertyValue('--theme-color')
      .trim()
    if (themeColor) meta.setAttribute('content', themeColor)
  }

  function applyTheme(preference) {
    const resolved = resolveTheme(preference)
    document.documentElement.setAttribute('data-theme', resolved)
    document.documentElement.setAttribute('data-theme-pref', preference)
    syncThemeColorMeta()
    try {
      localStorage.setItem('jsone-theme', preference)
    } catch {}
    return resolved
  }

  /**
   * Three preferences (system / light / dark), but skip steps that would not change
   * the resolved appearance (for example system to light when the OS is already light).
   */
  function nextPreference(current) {
    const preference =
      current === 'light' || current === 'dark' || current === 'system' ? current : 'system'
    const resolved = resolveTheme(preference)
    const systemResolved = resolveTheme('system')

    if (preference === 'system') {
      // Leave system by locking the opposite of what the user currently sees.
      return resolved === 'dark' ? 'light' : 'dark'
    }
    if (preference === 'light') return 'dark'
    // dark to system when that looks different; otherwise flip to light
    return systemResolved === 'dark' ? 'light' : 'system'
  }

  function syncToggle(button) {
    const preference = document.documentElement.getAttribute('data-theme-pref') || 'system'
    const sun = button.querySelector('[data-icon-sun]')
    const moon = button.querySelector('[data-icon-moon]')
    const system = button.querySelector('[data-icon-system]')
    sun?.classList.toggle('opacity-0', preference !== 'light')
    moon?.classList.toggle('opacity-0', preference !== 'dark')
    system?.classList.toggle('opacity-0', preference !== 'system')

    const next = nextPreference(preference)
    const nextLabel = next === 'light' ? toLight : next === 'dark' ? toDark : toSystem
    button.setAttribute('aria-label', `${label}: ${nextLabel}`)
    button.setAttribute('title', nextLabel)
  }

  function bindThemeToggle() {
    document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
      if (!(button instanceof HTMLElement) || button.dataset.bound === 'true') return
      button.dataset.bound = 'true'
      syncToggle(button)
      button.addEventListener('click', () => {
        const preference = document.documentElement.getAttribute('data-theme-pref') || 'system'
        applyTheme(nextPreference(preference))
        document.querySelectorAll('[data-theme-toggle]').forEach((other) => {
          if (other instanceof HTMLElement) syncToggle(other)
        })
      })
    })
  }

  function syncAllToggles() {
    document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
      if (button instanceof HTMLElement) syncToggle(button)
    })
  }

  bindThemeToggle()

  if (!window.__jsoneThemeBound) {
    window.__jsoneThemeBound = true
    document.addEventListener('astro:page-load', () => {
      bindThemeToggle()
      syncAllToggles()
    })
    document.addEventListener('astro:after-swap', syncAllToggles)
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      const preference = document.documentElement.getAttribute('data-theme-pref') || 'system'
      if (preference === 'system') {
        applyTheme('system')
        syncAllToggles()
      }
    })
  }
</script>

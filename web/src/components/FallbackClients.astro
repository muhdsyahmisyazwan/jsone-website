---
import type {Locale} from '../i18n/locales'
import {localePath} from '../i18n/paths'
import {t} from '../i18n/utils'

interface Props {
  locale: Locale
}

const {locale} = Astro.props

const stats = [
  {valueKey: 'home.statsExperienceValue', labelKey: 'home.statsExperienceLabel'},
  {valueKey: 'home.statsProjectsValue', labelKey: 'home.statsProjectsLabel'},
  {valueKey: 'home.statsClientsValue', labelKey: 'home.statsClientsLabel'},
] as const

const partners = [
  'OpenText',
  'SAP',
  'Extended ECM',
  'Data Archiving',
  'Document Access',
  'VIM',
  'Accounts Payable',
  'AMS',
]
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 surface-grid opacity-50" aria-hidden="true"></div>
  <div class="container-site space-y-4 py-20 lg:py-24">
    <p class="eyebrow">{t(locale, 'nav.clients')}</p>
    <h1 class="display-xl max-w-3xl text-fg">{t(locale, 'clients.heroTitle')}</h1>
    <p class="prose-measure text-base text-fg-muted sm:text-lg">
      {t(locale, 'clients.heroSubtitle')}
    </p>
  </div>
</section>

<section class="section-pad section-defer" data-reveal>
  <div class="container-site space-y-12">
    <div class="grid max-w-3xl grid-cols-3 gap-4 border-y border-border py-8">
      {
        stats.map((stat) => (
          <div class="min-w-0">
            <p class="metric text-2xl font-semibold text-fg sm:text-3xl">
              {t(locale, stat.valueKey)}
            </p>
            <p class="mt-1 text-sm text-fg-muted">{t(locale, stat.labelKey)}</p>
          </div>
        ))
      }
    </div>

    <div class="space-y-4">
      <h2 class="display-md text-fg">{t(locale, 'home.partnersHeading')}</h2>
      <ul class="flex flex-wrap gap-3" data-reveal-stagger>
        {
          partners.map((label) => (
            <li
              class="rounded-full border border-border bg-bg-elevated px-4 py-2 text-sm text-fg-muted"
              data-reveal-child
            >
              {label}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="space-y-4">
      <h2 class="display-md text-fg">{t(locale, 'clients.trustHeading')}</h2>
      <p class="prose-measure text-fg-muted">{t(locale, 'clients.trustBody')}</p>
      <a href={localePath(locale, '/contact/')} class="btn btn-primary">
        {t(locale, 'home.ctaPrimary')}
      </a>
    </div>
  </div>
</section>

---
import PageHero from './ui/PageHero.astro'
import CaseStudyCard from './trust/CaseStudyCard.astro'
import CertificationList from './trust/CertificationList.astro'
import ClientLogoStrip from './trust/ClientLogoStrip.astro'
import MetricBand from './trust/MetricBand.astro'
import PartnerBadgeRow from './trust/PartnerBadgeRow.astro'
import type {Locale} from '../i18n/locales'
import {localePath} from '../i18n/paths'
import {t} from '../i18n/utils'
import {
  getCaseStudies,
  getCertifications,
  getPartnerBadgesFull,
  getSectorPlaceholders,
  getTrustMetrics,
  getTrustMetricsContext,
} from '../lib/trust/fallback'

interface Props {
  locale: Locale
}

const {locale} = Astro.props

const metrics = getTrustMetrics(locale)
const metricsContext = getTrustMetricsContext(locale)
const sectors = getSectorPlaceholders(locale)
const badges = getPartnerBadgesFull(locale)
const cases = getCaseStudies(locale)
const certifications = getCertifications(locale)
---

<PageHero
  eyebrow={t(locale, 'nav.clients')}
  title={t(locale, 'clients.heroTitle')}
  subtitle={t(locale, 'clients.heroSubtitle')}
/>

<section class="section-pad section-defer" data-reveal>
  <div class="container-site space-y-14">
    <MetricBand
      metrics={metrics}
      context={metricsContext}
      heading={t(locale, 'clients.statsHeading')}
    />

    <ClientLogoStrip labels={sectors} eyebrow={t(locale, 'trust.sectorsEyebrow')} />

    <PartnerBadgeRow badges={badges} eyebrow={t(locale, 'trust.badgesEyebrow')} />

    {
      cases.length > 0 && (
        <div class="space-y-6">
          <div class="space-y-3">
            <h2 class="display-md text-fg">{t(locale, 'clients.casesHeading')}</h2>
            <p class="prose-measure text-fg-muted">{t(locale, 'clients.casesBody')}</p>
          </div>
          <ul class="grid gap-6 sm:grid-cols-3" data-reveal-stagger>
            {cases.map((item) => (
              <li>
                <CaseStudyCard
                  eyebrow={item.eyebrow}
                  title={item.title}
                  body={item.body}
                  metric={item.metric}
                />
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <CertificationList
      items={certifications}
      heading={t(locale, 'clients.recognitionHeading')}
      body={t(locale, 'clients.recognitionBody')}
    />

    <div class="space-y-4 border-t border-border pt-10">
      <h2 class="display-md text-fg">{t(locale, 'clients.trustHeading')}</h2>
      <p class="prose-measure text-fg-muted">{t(locale, 'clients.trustBody')}</p>
      <h3 class="text-lg font-semibold text-fg">{t(locale, 'clients.ctaHeading')}</h3>
      <p class="prose-measure text-fg-muted">{t(locale, 'clients.ctaBody')}</p>
      <a href={localePath(locale, '/contact/')} class="btn btn-cta">
        {t(locale, 'home.ctaPrimary')}
      </a>
    </div>
  </div>
</section>

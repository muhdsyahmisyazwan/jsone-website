---
/**
 * Fallback homepage when Sanity homepage content is missing / unreviewed.
 * Five sections, one job each: Hero → Capabilities → Proof → Why → CTA.
 */
import Icon from './icons/Icon.astro'
import SapOpenTextMap from './illustrations/SapOpenTextMap.astro'
import CaseStudyCard from './trust/CaseStudyCard.astro'
import ClientLogoStrip from './trust/ClientLogoStrip.astro'
import MetricBand from './trust/MetricBand.astro'
import PartnerBadgeRow from './trust/PartnerBadgeRow.astro'
import ProofTestimonial from './trust/ProofTestimonial.astro'
import {localePath} from '../i18n/paths'
import type {Locale} from '../i18n/locales'
import {t} from '../i18n/utils'
import {
  getFeaturedCase,
  getFeaturedTestimonial,
  getPartnerBadgesFull,
  getSectorPlaceholders,
  getTrustMetrics,
  getTrustMetricsContext,
} from '../lib/trust/fallback'

interface Props {
  locale: Locale
}

const {locale} = Astro.props

const title = t(locale, 'home.title')
const highlight = t(locale, 'home.titleHighlight')
const titleHtml = highlight && title.includes(highlight)
  ? title.replace(
      highlight,
      `<span class="title-accent">${highlight}</span>`,
    )
  : title

const capabilities = [
  {title: 'home.capEcmTitle', body: 'home.capEcmBody', icon: 'layers'},
  {title: 'home.capProcessTitle', body: 'home.capProcessBody', icon: 'workflow'},
  {title: 'home.capAmsTitle', body: 'home.capAmsBody', icon: 'support'},
  {title: 'home.capIntegrationTitle', body: 'home.capIntegrationBody', icon: 'plug'},
] as const

const outcomes = [
  'home.transformDigitize',
  'home.transformIntegrate',
  'home.transformGovern',
  'home.transformCapabilities',
] as const

const whyItems = [
  {key: 'home.whyConsulting', icon: 'users'},
  {key: 'home.whyAms', icon: 'support'},
  {key: 'home.whyPartnership', icon: 'spark'},
] as const

const trustMetrics = getTrustMetrics(locale)
const trustContext = getTrustMetricsContext(locale)
const sectorLabels = getSectorPlaceholders(locale)
const partnerBadges = getPartnerBadgesFull(locale)
const featuredCase = getFeaturedCase(locale)
const featuredTestimonial = getFeaturedTestimonial(locale)
const clientsHref = localePath(locale, '/clients/')
---

<section class="hero-stage relative overflow-hidden border-b border-border">
  <div class="hero-bleed pointer-events-none absolute inset-0 -z-10 surface-grid" aria-hidden="true"></div>

  <div
    class="relative lg:min-h-[min(36rem,calc(100dvh-var(--header-height)-2rem))]"
  >
    <div
      class="pointer-events-none absolute inset-y-0 right-0 hidden w-[min(58%,40rem)] items-center lg:flex"
      aria-hidden="true"
    >
      <SapOpenTextMap locale={locale} class="w-full pr-4 xl:pr-10" />
    </div>

    <div class="container-site relative grid items-center gap-8 py-10 sm:gap-10 sm:py-14 lg:py-16">
      <div class="min-w-0 max-w-xl space-y-4 bg-bg py-2 sm:space-y-6 lg:max-w-[42%] lg:py-4">
        <p class="eyebrow">{t(locale, 'site.name')} · {t(locale, 'home.eyebrowBrand')}</p>
        <h1 class="display-xl text-fg" data-preview-field="hero-heading" set:html={titleHtml} />
        <p class="prose-measure text-sm leading-relaxed text-fg-muted sm:text-base lg:text-lg">
          {t(locale, 'home.description')}
        </p>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <a href={localePath(locale, '/contact/')} class="btn btn-cta w-full sm:w-auto">
            {t(locale, 'home.ctaPrimary')}
          </a>
          <a href={localePath(locale, '/solutions/')} class="btn btn-ghost w-full sm:w-auto">
            {t(locale, 'home.ctaSecondary')}
          </a>
        </div>
      </div>

      <div class="min-w-0 lg:hidden">
        <SapOpenTextMap locale={locale} class="w-full" />
      </div>
    </div>
  </div>
</section>

<section class="section-pad section-defer" data-reveal>
  <div class="container-site space-y-10">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:flex-wrap sm:items-end">
      <div class="min-w-0 max-w-2xl space-y-3">
        <p class="eyebrow">{t(locale, 'home.sectionCapabilities')}</p>
        <h2 class="display-md text-fg">{t(locale, 'home.capabilitiesHeading')}</h2>
        <p class="prose-measure text-fg-muted">{t(locale, 'home.capabilitiesIntro')}</p>
      </div>
      <a href={localePath(locale, '/solutions/')} class="btn btn-ghost max-w-full">
        {t(locale, 'home.ctaSecondary')}
        <Icon name="arrow" class="size-4 shrink-0" />
      </a>
    </div>

    <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {
        outcomes.map((key) => (
          <li
            class="border border-border bg-bg-elevated px-4 py-3 text-sm leading-snug text-fg-muted"
            data-reveal-child
          >
            {t(locale, key)}
          </li>
        ))
      }
    </ul>

    <ul class="grid gap-px border border-border bg-border sm:grid-cols-2 lg:grid-cols-4">
      {
        capabilities.map((item) => (
          <li class="flex flex-col gap-4 bg-bg-elevated p-5 sm:p-6" data-reveal-child>
            <span class="inline-flex size-10 items-center justify-center border border-border text-primary">
              <Icon name={item.icon} class="size-5" />
            </span>
            <div class="space-y-2">
              <h3 class="text-xl font-semibold text-fg">{t(locale, item.title)}</h3>
              <p class="text-sm leading-relaxed text-fg-muted sm:text-base">{t(locale, item.body)}</p>
            </div>
            <a
              href={localePath(locale, '/solutions/')}
              class="mt-auto inline-flex min-h-11 items-center gap-1.5 py-2 text-sm font-semibold text-primary"
            >
              {t(locale, 'common.learnMore')}
              <Icon name="arrow" class="size-4" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section-pad section-defer bg-bg-muted/40" data-reveal>
  <div class="container-site space-y-12">
    <div class="max-w-2xl space-y-3">
      <p class="eyebrow">{t(locale, 'home.sectionProof')}</p>
      <h2 class="display-md text-fg">{t(locale, 'home.proofHeading')}</h2>
      <p class="prose-measure text-fg-muted">{t(locale, 'home.proofSupporting')}</p>
    </div>

    <ClientLogoStrip labels={sectorLabels} eyebrow={t(locale, 'trust.sectorsEyebrow')} />

    <MetricBand metrics={trustMetrics} context={trustContext} />

    <PartnerBadgeRow badges={partnerBadges} eyebrow={t(locale, 'trust.badgesEyebrow')} />

    {
      featuredCase && (
        <CaseStudyCard
          eyebrow={featuredCase.eyebrow}
          title={featuredCase.title}
          body={featuredCase.body}
          metric={featuredCase.metric}
          href={clientsHref}
          linkLabel={t(locale, 'trust.viewClients')}
        />
      )
    }

    {
      featuredTestimonial && (
        <ProofTestimonial
          locale={locale}
          quote={featuredTestimonial.quote}
          author={featuredTestimonial.author}
          role={featuredTestimonial.role}
          avatar={featuredTestimonial.avatar}
        />
      )
    }

    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a href={clientsHref} class="btn btn-cta w-full sm:w-auto">
        {t(locale, 'home.proofCtaPrimary')}
      </a>
      <a href={localePath(locale, '/about/')} class="btn btn-ghost w-full sm:w-auto">
        {t(locale, 'home.proofCtaSecondary')}
      </a>
    </div>
  </div>
</section>

<section class="section-pad section-defer" data-reveal>
  <div class="container-site">
    <div class="panel-invert surface-grid p-6 sm:p-10 lg:p-14">
      <div class="relative z-[1] grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:items-center">
        <div class="space-y-5">
          <div>
            <p class="eyebrow text-[color:var(--illust-primary-soft)]">{t(locale, 'home.sectionWhy')}</p>
            <h2 class="display-md mt-3 text-white">{t(locale, 'home.whyHeading')}</h2>
          </div>
          <a href={localePath(locale, '/about/')} class="btn btn-ghost border-white/25 text-white">
            {t(locale, 'home.whyCta')}
            <Icon name="arrow" class="size-4" />
          </a>
        </div>
        <ul class="grid gap-px border border-white/15 bg-white/15 sm:grid-cols-1">
          {
            whyItems.map((item) => (
              <li class="flex gap-3 bg-[#000c28] p-4">
                <span class="inline-flex size-9 shrink-0 items-center justify-center border border-white/20 text-[color:var(--illust-primary-soft)]">
                  <Icon name={item.icon} class="size-4" />
                </span>
                <p class="text-sm font-medium leading-snug text-white/95 sm:text-base">
                  {t(locale, item.key)}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="section-pad section-defer" data-reveal>
  <div class="container-site">
    <div class="panel-invert px-6 py-12 sm:px-10 sm:py-16">
      <div class="relative z-[1] max-w-2xl space-y-5">
        <h2 class="display-md text-white">{t(locale, 'home.ctaHeading')}</h2>
        <p class="prose-measure text-base leading-relaxed text-white/80">
          {t(locale, 'home.ctaBody')}
        </p>
        <a href={localePath(locale, '/contact/')} class="btn btn-cta">
          {t(locale, 'home.ctaPrimary')}
        </a>
      </div>
    </div>
  </div>
</section>

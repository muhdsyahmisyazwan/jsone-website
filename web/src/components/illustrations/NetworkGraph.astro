  viewBox="0 0 720 420"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <g stroke="var(--illust-primary)" stroke-width="1" stroke-linecap="square">
    <path d="M80 210H220M220 210L320 120M220 210L320 300M320 120H460M320 300H460M460 120L560 180M460 300L560 240M560 180H640M560 240H640"></path>
    <path d="M320 120V60M320 300V360M460 120V70M460 300V350" opacity="0.45"></path>
  </g>
  <g fill="var(--illust-primary)">
    <rect x="74" y="204" width="12" height="12"></rect>
    <rect x="212" y="202" width="16" height="16"></rect>
    <rect x="312" y="112" width="16" height="16"></rect>
    <rect x="312" y="292" width="16" height="16"></rect>
    <rect x="452" y="112" width="16" height="16"></rect>
    <rect x="452" y="292" width="16" height="16"></rect>
  </g>
  <g fill="var(--illust-accent)">
    <rect x="552" y="172" width="16" height="16"></rect>
    <rect x="552" y="232" width="16" height="16"></rect>

---
/**
 * Concept B hero: SAP processes linked to OpenText content.
 * Full-bleed plane: desktop triptych; mobile stacked panels with vertical bridges.
 */
import type {Locale} from '../../i18n/locales'
import {t} from '../../i18n/utils'

interface Props {
  class?: string
  locale: Locale
}

const {class: className = '', locale} = Astro.props

const sap = t(locale, 'home.heroMapSap')
const openText = t(locale, 'home.heroMapOpenText')
const integration = t(locale, 'home.heroMapIntegration')
const fiInvoice = t(locale, 'home.heroMapFiInvoice')
const mmOrder = t(locale, 'home.heroMapMmOrder')
const hrFile = t(locale, 'home.heroMapHrFile')
const contentSuite = t(locale, 'home.heroMapContentSuite')
const archive = t(locale, 'home.heroMapArchive')
const workflow = t(locale, 'home.heroMapWorkflow')
const vim = t(locale, 'home.heroMapVim')
const contentLink = t(locale, 'home.heroMapContentLink')
---

<div class:list={['sap-ot-map', className]}>
  {/* Desktop: SAP | Integration | OpenText */}
  <svg
    class="hidden w-full text-fg-subtle lg:block"
    viewBox="0 0 720 420"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <rect
      x="40"
      y="88"
      width="176"
      height="244"
      fill="var(--color-bg-elevated)"
      stroke="var(--illust-primary)"
      stroke-width="1.5"
    ></rect>
    <text
      x="128"
      y="116"
      text-anchor="middle"
      class="map-label map-label-title"
      fill="currentColor">{sap}</text>
    <rect x="56" y="136" width="144" height="40" stroke="var(--illust-primary)" stroke-width="1"></rect>
    <text x="68" y="161" class="map-label" fill="currentColor">{fiInvoice}</text>
    <rect x="56" y="188" width="144" height="40" stroke="var(--illust-primary)" stroke-width="1"></rect>
    <text x="68" y="213" class="map-label" fill="currentColor">{mmOrder}</text>
    <rect x="56" y="240" width="144" height="40" stroke="var(--illust-primary)" stroke-width="1"></rect>
    <text x="68" y="265" class="map-label" fill="currentColor">{hrFile}</text>
    <rect x="192" y="152" width="8" height="8" fill="var(--illust-primary)"></rect>
    <rect x="192" y="204" width="8" height="8" fill="var(--illust-primary)" fill-opacity="0.7"></rect>
    <rect x="192" y="256" width="8" height="8" fill="var(--illust-primary)" fill-opacity="0.7"></rect>

    <rect
      x="288"
      y="88"
      width="144"
      height="244"
      fill="var(--color-primary-soft)"
      fill-opacity="0.35"
      stroke="var(--illust-primary)"
      stroke-width="1"
      stroke-dasharray="4 4"
      opacity="0.9"
    ></rect>
    <text
      x="360"
      y="116"
      text-anchor="middle"
      class="map-label map-label-title"
      fill="currentColor">{integration}</text>
    <rect x="336" y="152" width="48" height="8" fill="var(--illust-accent)"></rect>
    <text x="360" y="180" text-anchor="middle" class="map-label" fill="currentColor">{vim}</text>
    <rect x="336" y="204" width="48" height="8" fill="var(--illust-primary)"></rect>
    <text x="360" y="232" text-anchor="middle" class="map-label" fill="currentColor">{contentLink}</text>
    <rect x="336" y="256" width="48" height="8" fill="var(--illust-primary)"></rect>

    <rect
      x="504"
      y="88"
      width="176"
      height="244"
      fill="var(--color-bg-elevated)"
      stroke="var(--illust-primary)"
      stroke-width="1.5"
    ></rect>
    <text
      x="592"
      y="116"
      text-anchor="middle"
      class="map-label map-label-title"
      fill="currentColor">{openText}</text>
    <rect x="520" y="136" width="144" height="40" stroke="var(--illust-primary)" stroke-width="1"></rect>
    <text x="532" y="161" class="map-label" fill="currentColor">{contentSuite}</text>
    <rect x="520" y="188" width="144" height="40" stroke="var(--illust-primary)" stroke-width="1"></rect>
    <text x="532" y="213" class="map-label" fill="currentColor">{archive}</text>
    <rect x="520" y="240" width="144" height="40" stroke="var(--illust-primary)" stroke-width="1"></rect>
    <text x="532" y="265" class="map-label" fill="currentColor">{workflow}</text>
    <rect x="504" y="152" width="8" height="8" fill="var(--illust-primary)"></rect>
    <rect x="504" y="204" width="8" height="8" fill="var(--illust-primary)" fill-opacity="0.7"></rect>
    <rect x="504" y="256" width="8" height="8" fill="var(--illust-primary)" fill-opacity="0.7"></rect>

    <path
      class="map-path map-path-accent"
      d="M200 156H336M384 156H504"
      stroke="var(--illust-accent)"
      stroke-width="1.5"
      stroke-linecap="square"
    ></path>
    <path
      d="M200 208H336M384 208H504"
      stroke="var(--illust-primary)"
      stroke-width="1.25"
      stroke-linecap="square"
      opacity="0.85"
    ></path>
    <path
      d="M200 260H336M384 260H504"
      stroke="var(--illust-primary)"
      stroke-width="1.25"
      stroke-linecap="square"
      opacity="0.85"
    ></path>
  </svg>

  {/* Mobile: SAP → bridge → OpenText */}
  <svg
    class="w-full text-fg-subtle lg:hidden"
    viewBox="0 0 720 360"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <rect
      x="80"
      y="24"
      width="560"
      height="112"
      fill="var(--color-bg-elevated)"
      stroke="var(--illust-primary)"
      stroke-width="1.5"
    ></rect>
    <text
      x="360"
      y="52"
      text-anchor="middle"
      class="map-label map-label-title"
      fill="currentColor">{sap}</text>
    <rect x="112" y="68" width="150" height="44" stroke="var(--illust-primary)" stroke-width="1"></rect>
    <text x="124" y="95" class="map-label" fill="currentColor">{fiInvoice}</text>
    <rect x="285" y="68" width="150" height="44" stroke="var(--illust-primary)" stroke-width="1"></rect>
    <text x="297" y="95" class="map-label" fill="currentColor">{mmOrder}</text>
    <rect x="458" y="68" width="150" height="44" stroke="var(--illust-primary)" stroke-width="1"></rect>
    <text x="470" y="95" class="map-label" fill="currentColor">{hrFile}</text>

    <text
      x="360"
      y="168"
      text-anchor="middle"
      class="map-label map-label-title"
      fill="currentColor">{integration}</text>
    <rect x="250" y="180" width="8" height="8" fill="var(--illust-accent)"></rect>
    <text x="268" y="188" class="map-label" fill="currentColor">{vim}</text>
    <rect x="400" y="180" width="8" height="8" fill="var(--illust-primary)"></rect>
    <text x="418" y="188" class="map-label" fill="currentColor">{contentLink}</text>
    <path
      class="map-path map-path-accent"
      d="M187 136V200"
      stroke="var(--illust-accent)"
      stroke-width="1.5"
      stroke-linecap="square"
    ></path>
    <path
      d="M360 136V200"
      stroke="var(--illust-primary)"
      stroke-width="1.25"
      stroke-linecap="square"
      opacity="0.85"
    ></path>
    <path
      d="M533 136V200"
      stroke="var(--illust-primary)"
      stroke-width="1.25"
      stroke-linecap="square"
      opacity="0.85"
    ></path>

    <rect
      x="80"
      y="212"
      width="560"
      height="112"
      fill="var(--color-bg-elevated)"
      stroke="var(--illust-primary)"
      stroke-width="1.5"
    ></rect>
    <text
      x="360"
      y="240"
      text-anchor="middle"
      class="map-label map-label-title"
      fill="currentColor">{openText}</text>
    <rect x="112" y="256" width="150" height="44" stroke="var(--illust-primary)" stroke-width="1"></rect>
    <text x="120" y="283" class="map-label" fill="currentColor">{contentSuite}</text>
    <rect x="285" y="256" width="150" height="44" stroke="var(--illust-primary)" stroke-width="1"></rect>
    <text x="318" y="283" class="map-label" fill="currentColor">{archive}</text>
    <rect x="458" y="256" width="150" height="44" stroke="var(--illust-primary)" stroke-width="1"></rect>
    <text x="478" y="283" class="map-label" fill="currentColor">{workflow}</text>
  </svg>
</div>

<style>
  .map-label {
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .map-label-title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: no-preference) {
    .map-path-accent {
      stroke-dasharray: 280;
      stroke-dashoffset: 280;
      animation: map-draw 0.48s var(--ease-out) 0.12s forwards;
    }
  }

  @keyframes map-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>

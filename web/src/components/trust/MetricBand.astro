---
/**
 * Delivery metrics with per-metric count context.
 * Renders only when at least two metrics are present.
 */
import type {TrustMetric} from '../../lib/trust/fallback'

interface Props {
  metrics: TrustMetric[]
  context?: string
  heading?: string
  class?: string
}

const {metrics = [], context, heading, class: className = ''} = Astro.props
const items = metrics.filter((metric) => metric.value?.trim() && metric.label?.trim())
---

{
  items.length >= 2 && (
    <div class:list={['space-y-4', className]}>
      {heading && <h2 class="display-md text-fg">{heading}</h2>}
      <div
        class:list={[
          'metric-band-grid grid max-w-3xl gap-6 border-y border-border py-8',
          items.length >= 3 ? 'grid-cols-1 sm:grid-cols-3' : 'grid-cols-1 sm:grid-cols-2',
        ]}
      >
        {items.map((metric) => (
          <div class="min-w-0">
            <p class="metric text-2xl font-semibold text-fg sm:text-3xl" data-count={metric.value}>
              {metric.value}
            </p>
            <p class="metric-band-label mt-1 text-fg-subtle">{metric.label}</p>
            {metric.context?.trim() && (
              <p class="mt-2 text-sm leading-snug text-fg-muted">{metric.context}</p>
            )}
          </div>
        ))}
      </div>
      {context && <p class="prose-measure text-sm text-fg-muted">{context}</p>}
    </div>
  )
}

---
/**
 * Client / sector proof strip.
 * Prefer CMS image logos later; text labels are the approved interim fallback.
 * Omits when no labels remain.
 */
import type {TrustSector} from '../../lib/trust/fallback'

interface Props {
  labels: TrustSector[] | string[]
  eyebrow?: string
  class?: string
}

const {labels = [], eyebrow, class: className = ''} = Astro.props
const items = labels
  .map((item) => (typeof item === 'string' ? item : item.label))
  .filter((label) => label?.trim())
---

{
  items.length > 0 && (
    <div class:list={['space-y-4', className]}>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <ul
        class:list={[
          'grid gap-px border border-border bg-border',
          items.length <= 2 && 'grid-cols-2',
          items.length === 3 && 'grid-cols-2 sm:grid-cols-3',
          items.length === 4 && 'grid-cols-2 sm:grid-cols-4',
          items.length === 5 && 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-5',
          items.length >= 6 && 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-6',
        ]}
        data-reveal-stagger
      >
        {items.map((label) => (
          <li
            class="flex min-h-14 items-center justify-center bg-bg-elevated px-3 py-3 text-center text-sm font-medium text-fg-muted"
            data-reveal-child
          >
            {label}
          </li>
        ))}
      </ul>
    </div>
  )
}

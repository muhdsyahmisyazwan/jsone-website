---
import BaseLayout from '../../layouts/BaseLayout.astro'
import FallbackTeam from '../../components/FallbackTeam.astro'
import Sections from '../../components/sections/Sections.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import {localePath} from '../../i18n/paths'
import {t} from '../../i18n/utils'
import {loadAboutRoute} from '../../lib/pages/loadPage'

const data = await loadAboutRoute('en', 'about-team', {
  titleKey: 'aboutTeam.metaTitle',
  descriptionKey: 'aboutTeam.metaDescription',
})
---

<BaseLayout
  locale={data.locale}
  title={data.title}
  description={data.description}
  ogImage={data.page?.seo?.ogImage}
  settings={data.settings}
  navigation={data.navigation}
  footer={data.footer}
>
  {
    data.page ? (
      <>
        <div class="container-site pt-6 sm:pt-8">
          <Breadcrumbs
            locale={data.locale}
            items={[
              {label: t(data.locale, 'nav.about'), href: localePath(data.locale, '/about/')},
              {label: t(data.locale, 'nav.aboutTeam')},
            ]}
          />
        </div>
        <Sections locale={data.locale} sections={data.page.sections} />
      </>
    ) : (
      <FallbackTeam locale={data.locale} />
    )
  }
</BaseLayout>

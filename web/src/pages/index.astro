---
import BaseLayout from '../layouts/BaseLayout.astro'
import FallbackHome from '../components/FallbackHome.astro'
import Sections from '../components/sections/Sections.astro'
import {preloadFromSections} from '../lib/preload'
import {loadHome} from '../lib/pages/loadHome'

const data = await loadHome('en')
const preloadImage = preloadFromSections(data.home?.sections)
---

<BaseLayout
  locale={data.locale}
  title={data.title}
  description={data.description}
  ogImage={data.home?.seo?.ogImage}
  settings={data.settings}
  navigation={data.navigation}
  footer={data.footer}
  preloadImage={preloadImage}
>
  {
    data.home?.sections?.length ? (
      <Sections locale={data.locale} sections={data.home.sections} localized />
    ) : (
      <FallbackHome locale={data.locale} />
    )
  }
</BaseLayout>

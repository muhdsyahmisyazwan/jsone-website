---
import BaseLayout from '../layouts/BaseLayout.astro'
import EmptyState from '../components/ui/EmptyState.astro'
import {localePath} from '../i18n/paths'
import {t} from '../i18n/utils'

const locale = 'en' as const
---

<BaseLayout
  locale={locale}
  title={`${t(locale, 'notFound.title')} - ${t(locale, 'site.name')}`}
  description={t(locale, 'notFound.description')}
  noindex
>
  <section class="container-site flex min-h-[60dvh] flex-col items-stretch justify-center py-20">
    <EmptyState
      eyebrow="404"
      titleAs="h1"
      title={t(locale, 'notFound.title')}
      body={t(locale, 'notFound.description')}
      actionHref={localePath(locale, '/')}
      actionLabel={t(locale, 'common.backToHome')}
    />
  </section>
</BaseLayout>

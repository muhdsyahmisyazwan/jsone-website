---
import BaseLayout from '../layouts/BaseLayout.astro'
import {localePath} from '../i18n/paths'
import {t} from '../i18n/utils'

const locale = 'en' as const
---

<BaseLayout
  locale={locale}
  title={`404 - ${t(locale, 'site.name')}`}
  description={t(locale, 'common.error')}
  noindex
>
  <section class="container-site flex min-h-[60dvh] flex-col items-start justify-center gap-6 py-20">
    <p class="eyebrow">404</p>
    <h1 class="display-lg max-w-xl text-fg">{t(locale, 'common.error')}</h1>
    <a href={localePath(locale, '/')} class="btn btn-brand">
      {t(locale, 'common.backToHome')}
    </a>
  </section>
</BaseLayout>

# Public site URL (also set in astro.config.mjs `site`)
PUBLIC_SITE_URL=https://www.jsone.com.my
SITE_ORIGIN=https://www.jsone.com.my

# Sanity Content Lake
PUBLIC_SANITY_PROJECT_ID=yourProjectId
PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Cloudflare Turnstile (CAPTCHA service — works without Cloudflare Pages)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local/dev only (never in production):
# TURNSTILE_SKIP=true

CONTACT_TO_EMAIL=info@jsone.com.my
CONTACT_FROM_EMAIL=JS One Website <noreply@jsone.com.my>
RESEND_API_KEY=

# Sanity webhook → rebuild on Ubuntu VM
SANITY_WEBHOOK_SECRET=
REBUILD_COMMAND=/var/www/jsone/scripts/rebuild.sh
# Optional if you also use Cloudflare Pages:
# CF_DEPLOY_HOOK_URL=

SANITY_PREVIEW_SECRET=

# Node server (Ubuntu / local `npm run start`)
HOST=0.0.0.0
PORT=4321
# STATIC_DIR= absolute path to web/dist (auto-detected if omitted)

# Privacy-friendly analytics (enable at most one)
PUBLIC_CF_WEB_ANALYTICS_TOKEN=
# PUBLIC_PLAUSIBLE_DOMAIN=jsone.com.my

# Public site URL (also set in astro.config.mjs `site`)
PUBLIC_SITE_URL=https://www.jsone.com.my
SITE_ORIGIN=https://www.jsone.com.my

# Sanity Content Lake
PUBLIC_SANITY_PROJECT_ID=yourProjectId
PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Cloudflare Turnstile (CAPTCHA service - works without Cloudflare Pages)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local/dev only (never in production - contact fails closed if set when NODE_ENV=production):
# TURNSTILE_SKIP=true

CONTACT_TO_EMAIL=info@jsone.com.my
CONTACT_FROM_EMAIL=JS One Website <noreply@jsone.com.my>
# Required in production (NODE_ENV=production)
RESEND_API_KEY=

# Sanity webhook → rebuild on Ubuntu VM
# Configure the webhook URL WITHOUT ?secret= - send the secret as a header instead:
#   x-sanity-webhook-secret: <value>
# or Authorization: Bearer <value>
# or enable Sanity's signature header (sanity-webhook-signature)
SANITY_WEBHOOK_SECRET=
# Absolute path only (no shell metacharacters). Example:
REBUILD_COMMAND=/var/www/jsone/scripts/rebuild.sh
# REBUILD_DEBOUNCE_MS=60000
# REBUILD_LOCK_PATH=/var/log/jsone/rebuild.node.lock
# REBUILD_LOG_PATH=/var/log/jsone/rebuild.log
# Emergency only - optional parallel deploy hook (not required for Ubuntu production):
# CF_DEPLOY_HOOK_URL=

# Rate limits (per client IP, in-memory per Node process)
# CONTACT_RATE_LIMIT=5
# CONTACT_RATE_WINDOW_MS=900000
# WEBHOOK_RATE_LIMIT=60
# WEBHOOK_RATE_WINDOW_MS=3600000

SANITY_PREVIEW_SECRET=

# Node server (Ubuntu / local `npm run start`)
# Production behind Nginx: bind loopback and trust X-Real-IP
HOST=127.0.0.1
PORT=4321
TRUST_PROXY=true
# STATIC_DIR= absolute path to web/dist (auto-detected if omitted)
# Optional CSP override (defaults allow Turnstile, Sanity CDN, Studio embed):
# CONTENT_SECURITY_POLICY=

# Privacy-friendly analytics (enable at most one)
PUBLIC_CF_WEB_ANALYTICS_TOKEN=
# PUBLIC_PLAUSIBLE_DOMAIN=jsone.com.my
